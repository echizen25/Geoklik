<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Keep normal HTTPS validation enabled for all traffic.

        For geoklik.philmech.gov.ph only, add a bundled modern Mozilla CA root
        store to the Android system/user trust anchors. This is intended for
        older Android devices whose built-in CA store may be stale.

        This is NOT a trust-all configuration. Android still validates the
        certificate chain and hostname, and cleartext HTTP remains disabled.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">geoklik.philmech.gov.ph</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/modern_ca_bundle" />
        </trust-anchors>
    </domain-config>
</network-security-config>
