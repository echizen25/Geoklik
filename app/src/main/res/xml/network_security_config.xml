<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
        Keep normal HTTPS validation enabled for all traffic.

        For geoklik.philmech.gov.ph only, trust the exact GlobalSign
        OrganizationSSL intermediate currently issuing the *.philmech.gov.ph
        certificate. This compensates for devices/servers that cannot build the
        full chain to GlobalSign Root R46 on their own.

        This is NOT a trust-all configuration. Android still validates the
        certificate chain and hostname, and cleartext HTTP remains disabled.
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">geoklik.philmech.gov.ph</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/globalsign_gcc_r46_ov_tls_ca_2025" />
            <certificates src="@raw/modern_ca_bundle" />
        </trust-anchors>
    </domain-config>
</network-security-config>
