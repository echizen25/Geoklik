<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="190dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/home_header_icon"
        android:scaleType="fitXY"
        android:contentDescription="@null"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="22dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <ImageView
            android:layout_width="190dp"
            android:layout_height="42dp"
            android:adjustViewBounds="true"
            android:contentDescription="@null"
            android:scaleType="centerCrop"
            android:src="@drawable/geoklik" />

        <TextView
            android:id="@+id/tvNavSubtitle"
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:maxLines="2"
            android:text="GEO TAGGING TOOL FOR IMAGE CAPTURE"
            android:textColor="#DFF5EB"
            android:textSize="7sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvNavVersion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Version 1.0.0"
            android:textColor="#BFE9D8"
            android:textSize="7sp" />
    </LinearLayout>

</FrameLayout>