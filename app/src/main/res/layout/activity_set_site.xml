<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/app_scrim" android:padding="12dp" android:fitsSystemWindows="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModal" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center"
        android:layout_marginHorizontal="14dp" android:layout_marginVertical="6dp"
        app:cardBackgroundColor="@color/app_surface_elevated" app:cardCornerRadius="20dp" app:cardElevation="4dp" app:strokeWidth="1dp" app:strokeColor="@color/app_brand_stroke_subtle">

        <ScrollView android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:overScrollMode="ifContentScrolls">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
                <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="46dp">
                        <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Change Project" android:textStyle="bold" android:textSize="18sp" android:textColor="@color/brand_green_ui" />
                        <TextView android:id="@+id/tvSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="Search a project, paste a code, or use QR." android:textSize="12sp" android:textColor="@color/app_text_muted" />
                    </LinearLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnClose" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="38dp" android:layout_height="38dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:text="" android:contentDescription="Close" app:icon="@drawable/ic_close_24" app:iconPadding="0dp" app:iconTint="@color/app_text_primary" app:rippleColor="@color/app_ripple_on_light" />
                </RelativeLayout>

                <com.google.android.material.card.MaterialCardView android:id="@+id/cardPersonalCapture" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" app:cardBackgroundColor="@color/app_surface_variant" app:cardCornerRadius="14dp" app:strokeColor="@color/app_brand_stroke_subtle" app:strokeWidth="1dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingStart="11dp" android:paddingTop="8dp" android:paddingEnd="8dp" android:paddingBottom="8dp">
                        <ImageView android:layout_width="22dp" android:layout_height="22dp" android:src="@drawable/ic_photo_library_24" android:contentDescription="@null" app:tint="@color/brand_green_ui" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Personal Capture" android:textColor="@color/app_text_primary" android:textSize="13sp" android:textStyle="bold" />
                            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:text="Not linked to an official project" android:textColor="@color/app_text_muted" android:textSize="10sp" android:maxLines="1" android:ellipsize="end" />
                        </LinearLayout>
                        <com.google.android.material.button.MaterialButton android:id="@+id/btnUncategorized" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="40dp" android:minWidth="64dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Use" android:textAllCaps="false" android:textColor="@color/brand_green_ui" app:cornerRadius="12dp" app:strokeColor="@color/app_brand_stroke" app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="13dp" android:text="PROJECT CAPTURE" android:textColor="@color/app_text_muted" android:textSize="10sp" android:textStyle="bold" android:letterSpacing="0.06" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSite"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Code, Site ID, project or beneficiary"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxStrokeColor="@color/app_brand_stroke"
                        app:hintTextColor="@color/app_text_muted">
                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actSite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions"
                            android:minHeight="50dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="10dp"
                            android:singleLine="true"
                            android:textColor="@color/app_text_primary"
                            android:textColorHint="@color/app_text_muted" />
                    </com.google.android.material.textfield.TextInputLayout>
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnPasteCode" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="68dp" android:layout_height="50dp" android:layout_marginStart="6dp" android:minWidth="0dp" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Paste" android:textAllCaps="false" android:textColor="@color/brand_green_ui" app:cornerRadius="12dp" app:rippleColor="@color/app_brand_ripple" />
                </LinearLayout>

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Start typing to see matching project suggestions." android:textSize="10sp" android:textColor="@color/app_text_faint" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="horizontal" android:gravity="center_vertical">
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnUseSelected" android:layout_width="0dp" android:layout_height="44dp" android:layout_weight="1.25" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Use Project" android:textAllCaps="false" android:textColor="@android:color/white" app:backgroundTint="@color/brand_green" app:cornerRadius="12dp" app:icon="@drawable/ic_check_24" app:iconPadding="6dp" app:iconTint="@android:color/white" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnScanQr" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:layout_weight="1" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Scan QR" android:textAllCaps="false" android:textColor="@color/brand_green_ui" app:cornerRadius="12dp" app:icon="@drawable/ic_qr_code_24" app:iconPadding="5dp" app:iconTint="@color/brand_green_ui" app:strokeColor="@color/app_brand_stroke" app:strokeWidth="1dp" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnUploadQr" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="0dp" android:layout_height="44dp" android:layout_marginStart="6dp" android:layout_weight="1" android:minHeight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:text="Image QR" android:textAllCaps="false" android:textColor="@color/brand_green_ui" app:cornerRadius="12dp" app:icon="@drawable/ic_photo_library_24" app:iconPadding="5dp" app:iconTint="@color/brand_green_ui" app:strokeColor="@color/app_brand_stroke" app:strokeWidth="1dp" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
