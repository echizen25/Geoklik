<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginHorizontal="18dp"
        android:layout_marginVertical="8dp"
        android:backgroundTint="@android:color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1A0B5A3C">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingEnd="48dp">

                        <TextView
                            android:id="@+id/tvTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Change Project"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#0B5A3C" />

                        <TextView
                            android:id="@+id/tvSubtitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Paste a copied project code, enter it manually, or use a project QR."
                            android:textSize="13sp"
                            android:textColor="#5B5B5B" />
                    </LinearLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnClose"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:insetLeft="0dp"
                        android:insetRight="0dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:minWidth="0dp"
                        android:minHeight="0dp"
                        android:text=""
                        app:icon="@drawable/ic_close_24"
                        app:iconPadding="0dp"
                        app:iconTint="#111111"
                        app:rippleColor="#14000000" />
                </RelativeLayout>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:backgroundTint="#EAF4EF"
                    app:cardCornerRadius="16dp"
                    app:strokeColor="#330B5A3C"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="PERSONAL CAPTURE"
                            android:textColor="#0B5A3C"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:text="Use this when the photo is not linked to an official project."
                            android:textSize="11sp"
                            android:textColor="#5F6A65" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnUncategorized"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="Start Personal Capture"
                            android:textAllCaps="false"
                            android:textColor="#0B5A3C"
                            app:backgroundTint="@android:color/white"
                            app:cornerRadius="14dp"
                            app:icon="@drawable/ic_photo_library_24"
                            app:iconPadding="10dp"
                            app:iconTint="#0B5A3C"
                            app:strokeColor="#330B5A3C"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="12dp"
                    android:background="#16000000" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PROJECT CAPTURE"
                    android:textColor="#6D6D6D"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSite"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="Project Code"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="#1A0B5A3C"
                        app:hintTextColor="#5B5B5B">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/actSite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:imeOptions="actionDone"
                            android:inputType="textNoSuggestions"
                            android:minHeight="54dp"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:singleLine="true" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <View
                        android:layout_width="8dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnPasteCode"
                        android:layout_width="wrap_content"
                        android:layout_height="54dp"
                        android:minWidth="76dp"
                        android:text="Paste"
                        android:textAllCaps="false"
                        android:textColor="#0B5A3C"
                        app:backgroundTint="#F3F7F5"
                        app:cornerRadius="14dp"
                        app:strokeColor="#330B5A3C"
                        app:strokeWidth="1dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="The project list is not shown here. GeoKlik resolves the code locally and determines Infrastructure or Project Activity automatically."
                    android:textSize="12sp"
                    android:textColor="#7A7A7A" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUseSelected"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Use Project Code"
                    android:textAllCaps="false"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#0B5A3C"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_check_24"
                    app:iconPadding="10dp"
                    app:iconTint="@android:color/white" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScanQr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Scan QR"
                        android:textAllCaps="false"
                        android:textColor="@android:color/white"
                        app:backgroundTint="#134F3A"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_qr_code_24"
                        app:iconPadding="8dp"
                        app:iconTint="@android:color/white" />

                    <View
                        android:layout_width="10dp"
                        android:layout_height="1dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUploadQr"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="QR from Image"
                        android:textAllCaps="false"
                        android:textColor="#0B5A3C"
                        app:backgroundTint="#EAF2EE"
                        app:cornerRadius="14dp"
                        app:icon="@drawable/ic_photo_library_24"
                        app:iconPadding="8dp"
                        app:iconTint="#0B5A3C"
                        app:strokeColor="#330B5A3C"
                        app:strokeWidth="1dp" />
                </LinearLayout>

            </LinearLayout>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
