<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#99000000"
    android:padding="16dp"
    android:fitsSystemWindows="true">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardModal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginHorizontal="18dp"
        android:backgroundTint="@android:color/white"
        app:cardCornerRadius="22dp"
        app:cardElevation="4dp"
        app:strokeWidth="1dp"
        app:strokeColor="#1A0B5A3C">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="18dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingEnd="48dp">

                    <TextView
                        android:id="@+id/tvTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Change Site"
                        android:textStyle="bold"
                        android:textSize="18sp"
                        android:textColor="#0B5A3C" />

                    <TextView
                        android:id="@+id/tvSubtitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Scan or type a Site ID from your synced local database."
                        android:textSize="13sp"
                        android:textColor="#5B5B5B" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClose"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:insetLeft="0dp"
                    android:insetRight="0dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:minHeight="0dp"
                    android:text=""
                    app:icon="@drawable/ic_close_24"
                    app:iconPadding="0dp"
                    app:iconTint="#111111"
                    app:rippleColor="#14000000" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilSite"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Type or scan Site ID"
                app:boxCornerRadiusTopStart="14dp"
                app:boxCornerRadiusTopEnd="14dp"
                app:boxCornerRadiusBottomStart="14dp"
                app:boxCornerRadiusBottomEnd="14dp"
                app:boxStrokeColor="#1A0B5A3C"
                app:endIconMode="dropdown_menu"
                app:hintTextColor="#5B5B5B">

                <com.google.android.material.textfield.MaterialAutoCompleteTextView
                    android:id="@+id/actSite"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:dropDownVerticalOffset="6dp"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:minHeight="54dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:popupBackground="@android:color/white"
                    android:singleLine="true" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="QR usually contains the raw Site ID. Labels are only for display."
                android:textSize="12sp"
                android:textColor="#7A7A7A" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUseSelected"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="Use Selected Site"
                android:textColor="@android:color/white"
                app:backgroundTint="#0B5A3C"
                app:cornerRadius="14dp"
                app:icon="@drawable/ic_check_24"
                app:iconPadding="10dp"
                app:iconTint="@android:color/white" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanQr"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Scan QR"
                    android:textColor="@android:color/white"
                    app:backgroundTint="#134F3A"
                    app:cornerRadius="14dp"
                    app:icon="@drawable/ic_qr_code_24"
                    app:iconPadding="10dp"
                    app:iconTint="@android:color/white" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="1dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnUncategorized"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="UNCATEGORIZED"
                    android:textColor="#0B5A3C"
                    app:backgroundTint="#E6E9E7"
                    app:cornerRadius="14dp"
                    app:strokeColor="#1A0B5A3C"
                    app:strokeWidth="1dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>