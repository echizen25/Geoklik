<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="280dp" android:layout_height="wrap_content" app:cardCornerRadius="14dp" app:cardElevation="8dp" app:cardBackgroundColor="@color/app_surface_elevated" app:strokeWidth="1dp" app:strokeColor="@color/app_border">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <FrameLayout android:layout_width="match_parent" android:layout_height="220dp" android:background="@color/app_surface_variant">
            <com.google.android.material.imageview.ShapeableImageView android:id="@+id/imgTooltip" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_gravity="center" android:adjustViewBounds="true" android:scaleType="fitCenter" android:contentDescription="Photo preview"/>
        </FrameLayout>
        <TextView android:id="@+id/tvTooltipTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingTop="10dp" android:paddingEnd="12dp" android:paddingBottom="12dp" android:textStyle="bold" android:textSize="14sp" android:textColor="@color/app_text_primary" android:maxLines="2" android:ellipsize="end"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>