<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@android:color/transparent" android:padding="8dp">

    <com.google.android.material.card.MaterialCardView android:id="@+id/cardModal" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginHorizontal="8dp"
        app:cardBackgroundColor="@color/app_surface_elevated" app:cardCornerRadius="22dp" app:cardElevation="4dp" app:strokeWidth="1dp" app:strokeColor="@color/app_brand_stroke_subtle">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp">
            <RelativeLayout android:layout_width="match_parent" android:layout_height="wrap_content">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingEnd="48dp">
                    <TextView android:id="@+id/tvTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Change Site" android:textColor="@color/brand_green_ui" android:textSize="18sp" android:textStyle="bold" />
                    <TextView android:id="@+id/tvSubtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Type or scan the correct Project Code for the selected photos." android:textColor="@color/app_text_muted" android:textSize="13sp" />
                </LinearLayout>
                <com.google.android.material.button.MaterialButton android:id="@+id/btnClose" style="@style/Widget.MaterialComponents.Button.TextButton" android:layout_width="40dp" android:layout_height="40dp" android:layout_alignParentEnd="true" android:layout_centerVertical="true" android:insetLeft="0dp" android:insetRight="0dp" android:insetTop="0dp" android:insetBottom="0dp" android:minWidth="0dp" android:minHeight="0dp" android:text="" app:icon="@drawable/ic_close_24" app:iconPadding="0dp" app:iconTint="@color/app_text_primary" app:rippleColor="@color/app_ripple_on_light" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="14dp" />

            <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilSite" style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Type or scan Project Code" app:boxCornerRadiusBottomEnd="14dp" app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusTopEnd="14dp" app:boxCornerRadiusTopStart="14dp" app:boxStrokeColor="@color/app_brand_stroke" app:hintTextColor="@color/app_text_muted">
                <com.google.android.material.textfield.MaterialAutoCompleteTextView android:id="@+id/actSite" android:layout_width="match_parent" android:layout_height="wrap_content" android:imeOptions="actionDone" android:inputType="text" android:minHeight="54dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:singleLine="true" android:textColor="@color/app_text_primary" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Selected photos will be moved to this project code and marked as PENDING for re-sync." android:textColor="@color/app_text_faint" android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton android:id="@+id/btnUseSelected" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="Apply Project Code" android:textColor="@android:color/white" app:backgroundTint="@color/brand_green" app:cornerRadius="14dp" app:icon="@drawable/ic_check_24" app:iconPadding="10dp" app:iconTint="@android:color/white" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnScanQr" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="Scan QR" android:textColor="@android:color/white" app:backgroundTint="@color/brand_green" app:cornerRadius="14dp" app:icon="@drawable/ic_qr_code_24" app:iconPadding="10dp" app:iconTint="@android:color/white" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>