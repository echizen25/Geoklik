<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F6F8FB">

    <!-- Toolbar -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:title="Settings"
        android:background="?attr/colorPrimary"
        app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back_24"
        app:navigationIconTint="@android:color/white"
        app:itemIconTint="@android:color/white"
        app:itemRippleColor="#40FFFFFF"
        app:menu="@menu/menu_settings_toolbar"/>

    <!-- Content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Page Title -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Site Settings"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#111827"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Configure the site used by GeoCamera."
                android:textSize="14sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp"/>

            <!-- Current Site -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:text="CURRENT SITE"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#0B5A3C"
                        android:letterSpacing="0.08"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <TextView
                        android:id="@+id/tvCurrentSelection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="-"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="#111827"
                        android:layout_marginTop="8dp"/>

                    <TextView
                        android:id="@+id/tvLatestDb"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Latest in DB: -"
                        android:textSize="13sp"
                        android:textColor="#6B7280"
                        android:layout_marginTop="6dp"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Select Site -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                app:cardCornerRadius="22dp"
                app:cardElevation="2dp"
                app:strokeColor="#E5E7EB"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:text="SELECT SITE"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"/>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilSite"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:hint="Type or select Site ID"
                        app:boxCornerRadiusTopStart="16dp"
                        app:boxCornerRadiusTopEnd="16dp"
                        app:boxCornerRadiusBottomStart="16dp"
                        app:boxCornerRadiusBottomEnd="16dp"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.MaterialAutoCompleteTextView
                            android:id="@+id/actSite"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:minHeight="56dp"
                            android:inputType="text"
                            android:imeOptions="actionDone"/>

                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnUseSelected"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Use Selected Site"
                        android:textColor="@android:color/white"
                        android:layout_marginTop="12dp"
                        app:backgroundTint="#0B5A3C"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_check_24"
                        app:iconTint="@android:color/white"/>

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Quick Actions -->
            <TextView
                android:text="Quick Actions"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScanQr"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Scan QR Code"
                android:layout_marginTop="10dp"
                app:icon="@drawable/ic_qr_code_24"
                app:cornerRadius="18dp"
                app:iconPadding="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUncategorized"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Use UNCATEGORIZED"
                android:layout_marginTop="8dp"
                app:cornerRadius="18dp"/>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>