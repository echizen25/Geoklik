<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="#14004B24"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgDateThumb"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- ✅ Remarks button (pill) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemarks"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="10dp"
            android:paddingEnd="12dp"
            android:text="Remarks"
            android:textSize="12sp"
            android:textAllCaps="false"
            android:textColor="@android:color/white"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_edit_24"
            app:iconSize="18dp"
            app:iconGravity="textStart"
            app:iconPadding="6dp"
            app:iconTint="@android:color/white"
            app:backgroundTint="?attr/colorPrimary"
            app:rippleColor="#22FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jan 25, 2026"
            android:textStyle="bold"
            android:textSize="15sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="10dp"
            app:layout_constraintStart_toEndOf="@id/imgDateThumb"
            app:layout_constraintEnd_toStartOf="@id/btnRemarks"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- ✅ Count only -->
        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="12 photos"
            android:textSize="12sp"
            android:alpha="0.85"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="4dp"
            app:layout_constraintStart_toStartOf="@id/tvDateTitle"
            app:layout_constraintEnd_toStartOf="@id/btnRemarks"
            app:layout_constraintTop_toBottomOf="@id/tvDateTitle" />

        <!-- ✅ Status line (simple + clear) -->
        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Status: SYNCED"
            android:textSize="12sp"
            android:textStyle="bold"
            android:alpha="0.90"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorPrimary"
            android:layout_marginTop="6dp"
            app:layout_constraintStart_toStartOf="@id/tvDateTitle"
            app:layout_constraintEnd_toStartOf="@id/btnRemarks"
            app:layout_constraintTop_toBottomOf="@id/tvPhotoCount" />

        <!-- ✅ Remarks preview (still optional) -->
        <TextView
            android:id="@+id/tvRemarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Remarks: ..."
            android:textSize="12sp"
            android:alpha="0.75"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvDateTitle"
            app:layout_constraintEnd_toStartOf="@id/btnRemarks"
            app:layout_constraintTop_toBottomOf="@id/tvSyncStatus" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>