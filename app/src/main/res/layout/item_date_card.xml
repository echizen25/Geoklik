<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardCornerRadius="18dp"
    app:cardElevation="1dp"
    app:strokeWidth="1dp"
    app:strokeColor="?attr/colorOutline"
    app:cardBackgroundColor="?attr/colorSurface">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="92dp"
        android:padding="12dp">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgDateThumb"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnRemarks"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:insetLeft="0dp"
            android:insetRight="0dp"
            android:paddingStart="9dp"
            android:paddingEnd="11dp"
            android:text="Remarks"
            android:textSize="11sp"
            android:textAllCaps="false"
            app:cornerRadius="20dp"
            app:icon="@drawable/ic_edit_24"
            app:iconSize="17dp"
            app:iconGravity="textStart"
            app:iconPadding="5dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvDateTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jan 25, 2026"
            android:textStyle="bold"
            android:textSize="16sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurface"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/imgDateThumb"
            app:layout_constraintEnd_toStartOf="@id/btnRemarks"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvPhotoCount"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="12 photos"
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="5dp"
            app:layout_constraintStart_toStartOf="@id/tvDateTitle"
            app:layout_constraintEnd_toStartOf="@id/btnRemarks"
            app:layout_constraintTop_toBottomOf="@id/tvDateTitle" />

        <TextView
            android:id="@+id/tvSyncStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYNCED"
            android:textSize="10sp"
            android:textStyle="bold"
            android:textColor="?attr/colorPrimary"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:background="@drawable/bg_chip_outline_green"
            android:layout_marginTop="8dp"
            app:layout_constraintStart_toStartOf="@id/tvDateTitle"
            app:layout_constraintTop_toBottomOf="@id/tvPhotoCount" />

        <TextView
            android:id="@+id/tvRemarks"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Remarks: ..."
            android:textSize="12sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:layout_marginTop="5dp"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="@id/tvDateTitle"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvSyncStatus"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
