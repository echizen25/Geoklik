<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/app_background">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:title="Projects Library" android:background="?attr/colorPrimary" app:titleTextColor="@android:color/white"
        app:navigationIcon="@drawable/ic_arrow_back_24" app:navigationIconTint="@android:color/white"
        app:itemIconTint="@android:color/white" app:itemRippleColor="#40FFFFFF" app:menu="@menu/menu_library_toolbar" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginStart="12dp" android:layout_marginTop="8dp" android:layout_marginEnd="12dp" android:visibility="gone"
        app:cardCornerRadius="14dp" app:cardElevation="0dp" app:cardBackgroundColor="@color/app_surface_variant"
        app:strokeColor="@color/app_brand_stroke_subtle" app:strokeWidth="1dp">
        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:hint="Search code, title, division, beneficiary, location" app:boxBackgroundMode="none"
            app:startIconDrawable="@drawable/ic_search_24" app:startIconTint="@color/app_icon_muted" app:endIconMode="clear_text">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etSearch" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:paddingStart="8dp" android:paddingTop="10dp" android:paddingEnd="8dp" android:paddingBottom="10dp"
                android:singleLine="true" android:textColor="@color/app_text_primary" android:textColorHint="@color/app_text_muted" android:textSize="14sp" />
        </com.google.android.material.textfield.TextInputLayout>
    </com.google.android.material.card.MaterialCardView>

    <HorizontalScrollView
        android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"
        android:fillViewport="false" android:paddingStart="12dp" android:paddingTop="8dp" android:paddingEnd="12dp" android:paddingBottom="5dp">
        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupType" android:layout_width="wrap_content" android:layout_height="wrap_content"
            app:singleSelection="true" app:selectionRequired="true" app:chipSpacingHorizontal="6dp">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipAll" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="48dp" android:layout_height="40dp" android:checked="true"
                android:text="" android:contentDescription="All documentation targets"
                app:chipIcon="@drawable/ic_filter_all_24" app:chipIconVisible="true" app:chipIconSize="20dp"
                app:chipIconTint="@color/app_icon_muted" app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipInfra" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="48dp" android:layout_height="40dp"
                android:text="" android:contentDescription="Infrastructure"
                app:chipIcon="@drawable/ic_filter_infrastructure_24" app:chipIconVisible="true" app:chipIconSize="20dp"
                app:chipIconTint="@color/app_icon_muted" app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipProject" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="48dp" android:layout_height="40dp"
                android:text="" android:contentDescription="Projects"
                app:chipIcon="@drawable/ic_filter_project_24" app:chipIconVisible="true" app:chipIconSize="20dp"
                app:chipIconTint="@color/app_icon_muted" app:ensureMinTouchTargetSize="false" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipActivity" style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="48dp" android:layout_height="40dp"
                android:text="" android:contentDescription="Activities"
                app:chipIcon="@drawable/ic_filter_activity_24" app:chipIconVisible="true" app:chipIconSize="20dp"
                app:chipIconTint="@color/app_icon_muted" app:ensureMinTouchTargetSize="false" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvProjects" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:paddingStart="12dp" android:paddingTop="2dp" android:paddingEnd="12dp" android:paddingBottom="12dp"/>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardEmpty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_margin="16dp" android:visibility="gone" app:cardCornerRadius="16dp" app:cardElevation="0dp"
        app:cardBackgroundColor="@color/app_surface_variant" app:strokeColor="@color/app_brand_stroke_subtle" app:strokeWidth="1dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:orientation="vertical" android:padding="22dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp" android:src="@drawable/ic_library_24" android:contentDescription="@null" app:tint="@color/app_icon_faint" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="No matching records" android:textColor="@color/app_text_primary" android:textSize="15sp" android:textStyle="bold" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="Try another filter or sync the library." android:textColor="@color/app_text_muted" android:textSize="12sp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
