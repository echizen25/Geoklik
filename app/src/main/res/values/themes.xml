<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GeoCamera" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_green</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand_green</item>
        <item name="colorOnSecondary">@color/white</item>

        <!-- GeoKlik intentionally uses one visual system in both phone modes. -->
        <item name="android:colorBackground">@color/app_background_warm</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_muted</item>
        <item name="colorOutline">@color/app_border</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/app_background_warm</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="colorControlActivated">@color/brand_green</item>
        <item name="colorControlHighlight">#1A004B24</item>
        <item name="colorAccent">@color/brand_green</item>
        <item name="android:spinnerStyle">@style/Widget.GeoCamera.Spinner</item>
    </style>

    <style name="ThemeOverlay.GeoCamera.GalleryToolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:colorControlNormal">@android:color/white</item>
        <item name="popupTheme">@style/ThemeOverlay.GeoCamera.Popup</item>
    </style>

    <!-- Toolbar is dark green, but its overflow/popup content must stay on the app's
         light surface. Keeping this separate prevents white toolbar foreground colors
         from leaking into the white popup menu. -->
    <style name="ThemeOverlay.GeoCamera.Popup" parent="ThemeOverlay.Material3.Light">
        <item name="android:colorBackground">@color/app_surface_elevated</item>
        <item name="colorSurface">@color/app_surface_elevated</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/app_text_secondary</item>
        <item name="android:textColorPrimary">@color/app_text_primary</item>
        <item name="android:textColorSecondary">@color/app_text_secondary</item>
        <item name="colorControlNormal">@color/app_text_secondary</item>
        <item name="android:colorControlNormal">@color/app_text_secondary</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Widget.GeoCamera.Spinner" parent="@android:style/Widget.Holo.Light.Spinner">
        <item name="android:popupBackground">@color/app_surface_elevated</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="Theme.GeoCamera.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/geoklik_splash_safe_512</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.GeoCamera</item>
    </style>

    <style name="Theme.GeoCamera.DialogActivity" parent="Theme.Material3.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>
</resources>
