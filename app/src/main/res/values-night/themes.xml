<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.GeoCamera" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#52C985</item>
        <item name="colorOnPrimary">#062312</item>
        <item name="colorSecondary">#52C985</item>
        <item name="colorOnSecondary">#062312</item>

        <item name="android:colorBackground">@color/app_background</item>
        <item name="colorSurface">@color/app_surface</item>
        <item name="colorOnSurface">@color/app_text_primary</item>
        <item name="colorSurfaceVariant">@color/app_surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/app_text_muted</item>
        <item name="colorOutline">@color/app_border</item>
        <item name="colorError">#FFB4AB</item>

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:windowLightNavigationBar">false</item>

        <item name="colorControlNormal">@color/app_text_primary</item>
        <item name="colorControlActivated">#52C985</item>
        <item name="colorControlHighlight">#3352C985</item>
        <item name="colorAccent">#52C985</item>
        <item name="android:spinnerStyle">@style/Widget.GeoCamera.Spinner</item>
    </style>

    <style name="ThemeOverlay.GeoCamera.GalleryToolbar" parent="ThemeOverlay.Material3.Dark.ActionBar">
        <item name="colorControlNormal">@android:color/white</item>
        <item name="android:colorControlNormal">@android:color/white</item>
    </style>

    <style name="Widget.GeoCamera.Spinner" parent="@android:style/Widget.Holo.Spinner">
        <item name="android:popupBackground">@color/app_surface_elevated</item>
        <item name="android:textColor">@color/app_text_primary</item>
    </style>

    <style name="Theme.GeoCamera.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_green</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/geoklik_splash_safe_512</item>
        <item name="windowSplashScreenIconBackgroundColor">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.GeoCamera</item>
    </style>

    <style name="Theme.GeoCamera.DialogActivity" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:backgroundDimEnabled">true</item>
    </style>
</resources>